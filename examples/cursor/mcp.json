{
  "mcpServers": {
    "omnia": {
      "type": "stdio",
      "command": "omnia-mcp",
      "args": [
        "serve"
      ],
      "env": {
        "OMNIA_DEFAULT_PROVIDER": "jev",
        "OMNIA_ALLOWED_PROVIDERS": "jev",
        "TYPESAFE_API_KEY": "${env:TYPESAFE_API_KEY}"
      }
    }
  }
}
