# OMNIA MCP — process configuration. Copy values to the MCP client's environment.
# The server does not automatically read .env files.
OMNIA_DEFAULT_PROVIDER=laya
OMNIA_ALLOWED_PROVIDERS=laya
# Required for JEV; each operator supplies their own credential.
TYPESAFE_API_KEY=
OMNIA_JEV_MODEL=jev-1.13.0
# Required for local inference: the complete approved Hugging Face commit SHA.
OMNIA_LAYA_MODEL=english
OMNIA_LAYA_REVISION=
OMNIA_LAYA_DEVICE=cpu
OMNIA_LAYA_THREADS=2
OMNIA_LAYA_MAX_LEN=512
OMNIA_LAYA_HEAD_MAX_LEN=192
OMNIA_LAYA_OFFLINE=false
# Omit to store under the current user's home directory.
OMNIA_DATABASE=var/decisions.sqlite3
OMNIA_CACHE_TTL_SECONDS=3600
OMNIA_RETENTION_DAYS=30
OMNIA_MAX_INPUT_BYTES=65536
OMNIA_MAX_QUESTIONS=8
OMNIA_MAX_OPTIONS=16
OMNIA_MAX_BATCH_ITEMS=16
OMNIA_MAX_CONCURRENT_REQUESTS=4
OMNIA_MAX_QUEUE_SIZE=32
OMNIA_MAX_REQUESTS_PER_MINUTE=120
OMNIA_MAX_REQUESTS_PER_DAY=10000
OMNIA_REQUEST_TIMEOUT_SECONDS=30
OMNIA_MAX_RETRIES=2
OMNIA_MAX_RESPONSE_BYTES=1048576
OMNIA_LOG_LEVEL=WARNING

